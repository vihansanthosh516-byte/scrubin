# Copy to .env and fill in. Never commit .env.
# Your public hostname, e.g. scrubin-or.duckdns.org (free from https://www.duckdns.org)
DOMAIN=scrubin-or.duckdns.org
# The Vercel site that is allowed to call the engine (comma-separated, no trailing slash)
ALLOWED_ORIGINS=https://scrubin.vercel.app
# Same values as the old Render service (Supabase keeps saved cases; the keys power voice and AI notes)
SUPABASE_URL=https://ewtwxcjshdejwpxeroeg.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
