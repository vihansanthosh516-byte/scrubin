[TEMPLATE]
[TEMPLATE]
VITE_ANALYTICS_ENDPOINT=https://analytics.example.com
VITE_ANALYTICS_WEBSITE_ID=your-website-id
VITE_SUPABASE_URL=my_supabase_url
VITE_SUPABASE_ANON_KEY=my_supabase_anon_key
VITE_GOOGLE_CLIENT_ID=my_google_client_id
GITHUB_CLIENT_SECRET=my_github_client_secret
GOOGLE_CLIENT_SECRET=my_google_client_secret
GROQ_API_KEY=my_groq_api_key
# Used by context-aware complication routing and AI debriefs.
GROQ_BASE_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_MS=2500
GROQ_MAX_FAILURES=3
GROQ_CIRCUIT_OPEN_MS=60000

# ── Deployment (Docker + Cloudflare Pages) ──
# Base origin of the API. Empty = same-origin (dev: Vite proxies /api to the
# Express server). On Cloudflare Pages, set this to the Docker API host,
# e.g. https://api.yourdomain.com — the browser will call it cross-origin.
VITE_API_URL=

# Comma-separated browser origins allowed to call the API (CORS). Add your
# Cloudflare Pages domain in production, e.g. https://scrubin.pages.dev
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Deterministic simulation seed (keep stable across deploys).
SIM_SEED=42

# Token for `npm run supabase:apply:run` — never commit or print it.
# SUPABASE_ACCESS_TOKEN=sbp_...
