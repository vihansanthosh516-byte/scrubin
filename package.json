{
  "name": "scrubin",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"client,server,engine\" -c \"cyan,magenta,yellow\" \"vite --host\" \"tsx watch server/index.ts\" \"npm run engine\"",
    "engine": "cd engine && .venv/bin/python -m uvicorn scrubin_engine.api.app:app --port 8000 --reload",
    "engine:setup": "cd engine && uv venv .venv && uv pip install -p .venv -e \".[dev]\"",
    "engine:test": "cd engine && .venv/bin/python -m pytest -q",
    "pack:py": "node scripts/pack-python.mjs",
    "test:browser-engine": "node scripts/pack-python.mjs && node scripts/pyodide-smoke.mjs",
    "predev": "node scripts/pack-python.mjs && node scripts/fetch-pyodide.mjs",
    "dev:client": "node scripts/pack-python.mjs && node scripts/fetch-pyodide.mjs && vite --host",
    "dev:server": "tsx watch server/index.ts",
    "build": "node scripts/pack-python.mjs && node scripts/fetch-pyodide.mjs && vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "preview": "vite preview --host",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "supabase:apply": "node scripts/apply-supabase.mjs",
    "supabase:apply:run": "node scripts/apply-supabase.mjs --apply",
    "supabase:check": "node scripts/apply-supabase.mjs --check"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@supabase/supabase-js": "^2.101.1",
    "@types/canvas-confetti": "^1.6.4",
    "axios": "^1.12.0",
    "canvas-confetti": "^1.9.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "framer-motion": "^12.23.22",
    "groq-sdk": "^0.9.1",
    "helmet": "^8.3.0",
    "lucide-react": "^0.453.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "recharts": "^2.15.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "three": "^0.183.2",
    "wouter": "^3.3.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "4.17.21",
    "@types/google.maps": "^3.58.1",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "esbuild": "^0.25.0",
    "jsdom": "^26.1.0",
    "pg": "^8.23.0",
    "postcss": "^8.4.47",
    "prettier": "^3.6.2",
    "pyodide": "314.0.7",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.19.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.6.3",
    "vite": "^7.1.7",
    "vitest": "^2.1.4"
  }
}
